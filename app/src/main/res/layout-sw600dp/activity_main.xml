<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="24dp"
    android:baselineAligned="false"
    tools:context=".MainActivity">
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/profile_photo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scaleType="fitCenter"
                tools:srcCompat="@tools:sample/avatars"
                android:importantForAccessibility="no"
                android:adjustViewBounds="true"
                android:maxHeight="280dp" />
            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                tools:text="@string/employee_name"
                android:layout_marginTop="24dp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="24dp"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/emailLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/email_label"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:layout_marginTop="0dp" />
            <TextView
                android:id="@+id/email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                tools:text="@string/employee_email"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/extensionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/extension_label"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:layout_marginTop="24dp" />
            <TextView
                android:id="@+id/extension"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                tools:text="@string/extension_number"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/departmentLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/department_label"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:layout_marginTop="24dp" />
            <TextView
                android:id="@+id/department"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                tools:text="@string/department_name"
                android:layout_marginTop="4dp" />
            <TextView
                android:id="@+id/supervisorLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/supervisor_label"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:layout_marginTop="24dp" />
            <TextView
                android:id="@+id/supervisor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                tools:text="@string/supervisor_name"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="24dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/directReportsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/direct_reports_label"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
            android:layout_marginBottom="16dp" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/directReportsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
